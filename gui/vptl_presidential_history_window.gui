# Generated Presidential Library window: edit the generator rather than this output file.
# The GUI reads prepared country variables and checks scope validity before showing names or icons.

window = {
	name = "vptl_presidential_history_window"
	layer = top
	parentanchor = center
	size = { 1040 850 }
	allow_outside = yes
	visible = "[And(GetVariableSystem.Exists('vptl_presidential_history_panel_open'), GetMetaPlayer.GetPlayedOrObservedCountry.IsValid)]"
	datacontext = "[GetMetaPlayer.GetPlayedOrObservedCountry]"
	background = { using = paper_bg }
	vbox = {
		margin = { 24 18 }
		spacing = 7
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		hbox = {
			layoutpolicy_horizontal = expanding
			size = { 992 42 }
			textbox = { text = "vptl_presidential_library_title" fontsize = 28 align = center|nobaseline layoutpolicy_horizontal = expanding }
			button = { size = { 36 36 } using = default_button_primary onclick = "[GetVariableSystem.Clear('vptl_presidential_history_panel_open')]" icon = { parentanchor = center size = { 22 22 } texture = "gfx/interface/buttons/button_icons/close.dds" } }
		}
		textbox = { visible = "[LessThan_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_count').GetValue, '(CFixedPoint)1')]" layoutpolicy_horizontal = expanding size = { 992 80 } text = "vptl_presidential_history_empty" align = center|nobaseline fontsize = 18 }
		scrollarea = {
			visible = "[GreaterThanOrEqualTo_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_count').GetValue, '(CFixedPoint)1')]"
			size = { 992 770 }
			scrollbarpolicy_horizontal = always_off
			scrollbaralign_vertical = right
			scrollbar_vertical = { using = vertical_scrollbar }
			scrollwidget = {
				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = preferred
					spacing = 5
					widget = {
						visible = "[And(GreaterThanOrEqualTo_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_count').GetValue, '(CFixedPoint)1'), Country.MakeScope.Var('vptl_presidential_history_display_1_populated').IsSet)]"
						size = { 964 210 }
						background = { using = entry_bg_fancy_dark alpha = 0.42 }
						hbox = {
							margin = { 18 8 }
							vbox = {
								spacing = 2
								hbox = { spacing = 6
									textbox = { size = { 64 34 } raw_text = "#BOLD No. [Country.MakeScope.Var('vptl_presidential_history_display_1_number').GetValue|0]#!" fontsize = 18 align = left|nobaseline }
									widget = {
										size = { 300 34 }
										textbox = { visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_president_identity').GetValue, '(CFixedPoint)1')]" size = { 300 34 } text = "vptl_presidential_history_identity_andrew_jackson" tooltip = "vptl_presidential_history_identity_andrew_jackson" fontsize = 24 elide = right align = left|nobaseline }
										textbox = { visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_president_identity').GetValue, '(CFixedPoint)2')]" size = { 300 34 } text = "vptl_presidential_history_identity_winfield_scott" tooltip = "vptl_presidential_history_identity_winfield_scott" fontsize = 24 elide = right align = left|nobaseline }
										textbox = { visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_president_identity').GetValue, '(CFixedPoint)3')]" size = { 300 34 } text = "vptl_presidential_history_identity_john_calhoun" tooltip = "vptl_presidential_history_identity_john_calhoun" fontsize = 24 elide = right align = left|nobaseline }
										textbox = { visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_president_identity').GetValue, '(CFixedPoint)4')]" size = { 300 34 } text = "vptl_presidential_history_identity_daniel_webster" tooltip = "vptl_presidential_history_identity_daniel_webster" fontsize = 24 elide = right align = left|nobaseline }
