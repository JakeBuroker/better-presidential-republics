window = {
	name = "vptl_presidential_history_window"
	layer = top
	parentanchor = center
	size = { 980 830 }
	allow_outside = yes
	visible = "[And(GetVariableSystem.Exists('vptl_presidential_history_panel_open'), GetMetaPlayer.GetPlayedOrObservedCountry.IsValid)]"
	datacontext = "[GetMetaPlayer.GetPlayedOrObservedCountry]"
	background = { using = paper_bg }

	vbox = {
		margin = { 26 20 }
		spacing = 8
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		hbox = {
			layoutpolicy_horizontal = expanding
			size = { 928 42 }
			textbox = { text = "vptl_presidential_history_section" fontsize = 28 align = center|nobaseline layoutpolicy_horizontal = expanding }
			button = {
				size = { 36 36 }
				using = default_button_primary
				onclick = "[GetVariableSystem.Clear('vptl_presidential_history_panel_open')]"
				icon = { parentanchor = center size = { 22 22 } texture = "gfx/interface/buttons/button_icons/close.dds" }
			}
		}
		textbox = {
			visible = "[LessThan_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_count').GetValue, '(CFixedPoint)1')]"
			layoutpolicy_horizontal = expanding
			size = { 928 80 }
			text = "vptl_presidential_history_empty"
			align = center|nobaseline
			fontsize = 18
		}
		scrollarea = {
			visible = "[GreaterThanOrEqualTo_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_count').GetValue, '(CFixedPoint)1')]"
			size = { 928 742 }
			scrollbarpolicy_horizontal = always_off
			scrollbaralign_vertical = right
			scrollbar_vertical = { using = vertical_scrollbar }
			scrollwidget = {
				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = preferred
					spacing = 6
					widget = {
						visible = "[And(GreaterThanOrEqualTo_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_count').GetValue, '(CFixedPoint)1'), Country.MakeScope.Var('vptl_presidential_history_display_1_populated').IsSet)]"
						size = { 900 142 }
						background = { using = entry_bg_fancy_dark alpha = 0.34 }
						vbox = {
							margin = { 14 8 }
							spacing = 3
							hbox = {
								spacing = 12
								textbox = { visible = "[Country.MakeScope.Var('vptl_presidential_history_display_1_president').GetCharacter.IsValid]" size = { 390 25 } raw_text = "#BOLD [Country.MakeScope.Var('vptl_presidential_history_display_1_president').GetCharacter.GetFullName]#!" fontsize = 18 elide = right }
								textbox = { visible = "[Not(Country.MakeScope.Var('vptl_presidential_history_display_1_president').GetCharacter.IsValid)]" size = { 390 25 } text = "vptl_presidential_history_unavailable_president" fontsize = 18 elide = right }
								textbox = { size = { 105 24 } raw_text = "No. [Country.MakeScope.Var('vptl_presidential_history_display_1_number').GetValue|0]" fontsize = 14 }
								textbox = { visible = "[Not(GreaterThan_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_closed').GetValue, '(CFixedPoint)0'))]" size = { 130 24 } text = "vptl_presidential_history_current_episode" fontsize = 13 }
								textbox = { visible = "[GreaterThan_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_closed').GetValue, '(CFixedPoint)0')]" size = { 130 24 } text = "vptl_presidential_history_former_episode" fontsize = 13 }
								textbox = { visible = "[Not(GreaterThan_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_closed').GetValue, '(CFixedPoint)0'))]" size = { 205 24 } raw_text = "Since [Country.MakeScope.Var('vptl_presidential_history_display_1_start_month').GetValue|0]/[Country.MakeScope.Var('vptl_presidential_history_display_1_start_year').GetValue|0]" fontsize = 13 align = right|nobaseline }
								textbox = { visible = "[GreaterThan_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_closed').GetValue, '(CFixedPoint)0')]" size = { 205 24 } raw_text = "[Country.MakeScope.Var('vptl_presidential_history_display_1_start_month').GetValue|0]/[Country.MakeScope.Var('vptl_presidential_history_display_1_start_year').GetValue|0] - [Country.MakeScope.Var('vptl_presidential_history_display_1_end_month').GetValue|0]/[Country.MakeScope.Var('vptl_presidential_history_display_1_end_year').GetValue|0]" fontsize = 13 align = right|nobaseline }
							}
							hbox = {
								spacing = 8
								textbox = { visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_accession_type').GetValue, '(CFixedPoint)1')]" size = { 425 20 } text = "vptl_presidential_history_accession_elected" fontsize = 13 elide = right }
								textbox = { visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_accession_type').GetValue, '(CFixedPoint)2')]" size = { 425 20 } text = "vptl_presidential_history_accession_succeeded" fontsize = 13 elide = right }
								textbox = { visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_accession_type').GetValue, '(CFixedPoint)3')]" size = { 425 20 } text = "vptl_presidential_history_accession_interim" fontsize = 13 elide = right }
								textbox = { visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_accession_type').GetValue, '(CFixedPoint)4')]" size = { 425 20 } text = "vptl_presidential_history_accession_provisional" fontsize = 13 elide = right }
								textbox = { visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_accession_type').GetValue, '(CFixedPoint)5')]" size = { 425 20 } text = "vptl_presidential_history_accession_initial" fontsize = 13 elide = right }
								textbox = { visible = "[EqualTo_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_accession_type').GetValue, '(CFixedPoint)0')]" size = { 425 20 } text = "vptl_presidential_history_accession_unrecorded" fontsize = 13 elide = right }
								textbox = { visible = "[Not(GreaterThan_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_closed').GetValue, '(CFixedPoint)0'))]" size = { 425 20 } text = "vptl_presidential_history_departure_open" fontsize = 13 elide = right }
								textbox = { visible = "[And(GreaterThan_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_closed').GetValue, '(CFixedPoint)0'), EqualTo_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_departure_reason').GetValue, '(CFixedPoint)1'))]" size = { 425 20 } text = "vptl_presidential_history_departure_death" fontsize = 13 elide = right }
								textbox = { visible = "[And(GreaterThan_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_closed').GetValue, '(CFixedPoint)0'), EqualTo_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_departure_reason').GetValue, '(CFixedPoint)2'))]" size = { 425 20 } text = "vptl_presidential_history_departure_election" fontsize = 13 elide = right }
								textbox = { visible = "[And(GreaterThan_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_closed').GetValue, '(CFixedPoint)0'), EqualTo_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_departure_reason').GetValue, '(CFixedPoint)3'))]" size = { 425 20 } text = "vptl_presidential_history_departure_removal" fontsize = 13 elide = right }
								textbox = { visible = "[And(GreaterThan_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_closed').GetValue, '(CFixedPoint)0'), EqualTo_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_departure_reason').GetValue, '(CFixedPoint)4'))]" size = { 425 20 } text = "vptl_presidential_history_departure_government" fontsize = 13 elide = right }
								textbox = { visible = "[And(GreaterThan_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_closed').GetValue, '(CFixedPoint)0'), EqualTo_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_departure_reason').GetValue, '(CFixedPoint)5'))]" size = { 425 20 } text = "vptl_presidential_history_departure_unexpected" fontsize = 13 elide = right }
							}
							hbox = {
								spacing = 8
								textbox = { size = { 100 20 } text = "vptl_presidential_history_vice_president_label" fontsize = 13 }
								textbox = { visible = "[Country.MakeScope.Var('vptl_presidential_history_display_1_vice_president').GetCharacter.IsValid]" size = { 235 20 } raw_text = "[Country.MakeScope.Var('vptl_presidential_history_display_1_vice_president').GetCharacter.GetFullName]" fontsize = 13 elide = right }
								textbox = { visible = "[Not(Country.MakeScope.Var('vptl_presidential_history_display_1_vice_president').GetCharacter.IsValid)]" size = { 235 20 } text = "vptl_presidential_history_unavailable_vice_president" fontsize = 13 elide = right }
								textbox = { size = { 48 20 } text = "vptl_presidential_history_party_label" fontsize = 13 }
								textbox = { visible = "[Country.MakeScope.Var('vptl_presidential_history_display_1_party').GetParty.IsValid]" size = { 190 20 } raw_text = "[Country.MakeScope.Var('vptl_presidential_history_display_1_party').GetParty.GetName]" fontsize = 13 elide = right }
								textbox = { visible = "[Not(Country.MakeScope.Var('vptl_presidential_history_display_1_party').GetParty.IsValid)]" size = { 190 20 } text = "vptl_presidential_history_unavailable_party" fontsize = 13 elide = right }
								textbox = { size = { 32 20 } text = "vptl_presidential_history_ig_label" fontsize = 13 }
								textbox = { visible = "[Country.MakeScope.Var('vptl_presidential_history_display_1_ig').GetInterestGroup.IsValid]" size = { 170 20 } raw_text = "[Country.MakeScope.Var('vptl_presidential_history_display_1_ig').GetInterestGroup.GetName]" fontsize = 13 elide = right }
								textbox = { visible = "[Not(Country.MakeScope.Var('vptl_presidential_history_display_1_ig').GetInterestGroup.IsValid)]" size = { 170 20 } text = "vptl_presidential_history_unavailable_ig" fontsize = 13 elide = right }
							}
							hbox = {
								spacing = 22
								textbox = { size = { 235 20 } raw_text = "Terms: [Country.MakeScope.Var('vptl_presidential_history_display_1_terms_at_start').GetValue|0] - [Country.MakeScope.Var('vptl_presidential_history_display_1_terms_at_end').GetValue|0]" fontsize = 13 }
								textbox = { size = { 295 20 } raw_text = "GDP: [Country.MakeScope.Var('vptl_presidential_history_display_1_gdp_start').GetValue|D] - [Country.MakeScope.Var('vptl_presidential_history_display_1_gdp_end').GetValue|D]" fontsize = 13 }
								textbox = { size = { 290 20 } raw_text = "Prestige: [Country.MakeScope.Var('vptl_presidential_history_display_1_prestige_start').GetValue|0] - [Country.MakeScope.Var('vptl_presidential_history_display_1_prestige_end').GetValue|0]" fontsize = 13 }
							}
						}
					}
					widget = {
						visible = "[And(GreaterThanOrEqualTo_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_count').GetValue, '(CFixedPoint)2'), Country.MakeScope.Var('vptl_presidential_history_display_2_populated').IsSet)]"
