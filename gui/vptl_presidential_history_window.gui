# Generated Presidential Library window: edit the generator rather than this output file.
# The GUI reads prepared country variables and checks scope validity before showing names or icons.

window = {
	name = "vptl_presidential_history_window"
	layer = top
	parentanchor = center
	size = { 1040 850 }
	allow_outside = yes
	visible = "[And(GetVariableSystem.Exists('vptl_presidential_history_panel_open'), GetMetaPlayer.GetPlayedOrObservedCountry.IsValid)]"
	datacontext = "[GetMetaPlayer.GetPlayedOrObservedCountry]"
	background = { using = paper_bg }
	vbox = {
		margin = { 24 18 }
		spacing = 7
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		hbox = {
			layoutpolicy_horizontal = expanding
			size = { 992 42 }
			textbox = { text = "vptl_presidential_library_title" fontsize = 28 align = center|nobaseline layoutpolicy_horizontal = expanding }
			button = { size = { 36 36 } using = default_button_primary onclick = "[GetVariableSystem.Clear('vptl_presidential_history_panel_open')]" icon = { parentanchor = center size = { 22 22 } texture = "gfx/interface/buttons/button_icons/close.dds" } }
		}
		textbox = { visible = "[LessThan_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_count').GetValue, '(CFixedPoint)1')]" layoutpolicy_horizontal = expanding size = { 992 80 } text = "vptl_presidential_history_empty" align = center|nobaseline fontsize = 18 }
		scrollarea = {
			visible = "[GreaterThanOrEqualTo_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_count').GetValue, '(CFixedPoint)1')]"
			size = { 992 770 }
			scrollbarpolicy_horizontal = always_off
			scrollbaralign_vertical = right
			scrollbar_vertical = { using = vertical_scrollbar }
			scrollwidget = {
				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = preferred
					spacing = 5
					widget = {
						visible = "[And(GreaterThanOrEqualTo_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_count').GetValue, '(CFixedPoint)1'), Country.MakeScope.Var('vptl_presidential_history_display_1_populated').IsSet)]"
						size = { 964 146 }
