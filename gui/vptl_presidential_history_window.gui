										size = { 276 30 }
										textbox = { visible = "[And(Not(Country.MakeScope.Var('vptl_presidential_history_display_1_president').GetCharacter.IsValid), EqualTo_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_president_identity').GetValue, '(CFixedPoint)1'))]" size = { 276 30 } text = "vptl_presidential_history_identity_andrew_jackson" fontsize = 23 elide = right align = left|nobaseline }
										textbox = { visible = "[And(Not(Country.MakeScope.Var('vptl_presidential_history_display_1_president').GetCharacter.IsValid), EqualTo_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_1_president_identity').GetValue, '(CFixedPoint)2'))]" size = { 276 30 } text = "vptl_presidential_history_identity_winfield_scott" fontsize = 23 elide = right align = left|nobaseline }
