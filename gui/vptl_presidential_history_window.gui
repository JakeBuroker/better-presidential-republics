								textbox = { visible = "[GreaterThan_CFixedPoint(Country.MakeScope.Var('vptl_presidential_history_display_2_closed').GetValue, '(CFixedPoint)0')]" size = { 205 24 } raw_text = "[Country.MakeScope.Var('vptl_presidential_history_display_2_start_month').GetValue|0]/[Country.MakeScope.Var('vptl_presidential_history_display_2_start_year').GetValue|0] - [Country.MakeScope.Var('vptl_presidential_history_display_2_end_month').GetValue|0]/[Country.MakeScope.Var('vptl_presidential_history_display_2_end_year').GetValue|0]" fontsize = 13 align = right|nobaseline }
