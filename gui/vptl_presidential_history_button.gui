window = {
	name = "vptl_presidential_history_button"
	layer = top
	parentanchor = top|left
	position = { 106 93 }
	size = { 31 31 }
	allow_outside = yes
	visible = "[GetMetaPlayer.GetPlayedOrObservedCountry.IsValid]"
	sidepanel_button_small = {
		size = { 29 29 }
		parentanchor = center
		tooltip = "vptl_presidential_history_open_tooltip"
		onclick = "[GetScriptedGui('vptl_open_presidential_history_ledger_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		onclick = "[GetVariableSystem.Toggle('vptl_presidential_history_panel_open')]"
		icon = { size = { 29 29 } texture = "gfx/interface/icons/generic_icons/historical_character_icon.dds" }
	}
}
